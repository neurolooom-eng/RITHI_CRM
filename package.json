{
  "name": "rithi-crm-field-service",
  "private": true,
  "version": "0.9.362",
  "type": "module",
  "description": "RITHI CRM - Field Service Module POC (Medical Domain)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "docs:reqs": "esbuild scripts/requirements-doc.ts --bundle --platform=node --format=esm --define:import.meta.env={} --outfile=node_modules/.cache/requirements-doc.mjs --log-level=error && node node_modules/.cache/requirements-doc.mjs > docs/REQUIREMENTS.md",
    "check:mapping": "esbuild scripts/check-report-mapping.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-report-mapping.mjs --log-level=error && node node_modules/.cache/check-report-mapping.mjs",
    "check:uploads": "esbuild scripts/check-uploads.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-uploads.mjs --log-level=error && node node_modules/.cache/check-uploads.mjs",
    "check:upserts": "node scripts/check-upsert-targets.mjs",
    "check:safe-updates": "node scripts/check-safe-updates.mjs",
    "check:columns": "esbuild scripts/check-upload-columns.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-upload-columns.mjs --log-level=error && node node_modules/.cache/check-upload-columns.mjs",
    "check:ui": "esbuild scripts/check-ui.ts --bundle --platform=node --format=esm --define:import.meta.env={} --outfile=node_modules/.cache/check-ui.mjs --log-level=error && node node_modules/.cache/check-ui.mjs",
    "check:bundles": "node scripts/check-bundles.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "check:views": "node scripts/check-views.mjs",
    "check:replay": "node scripts/check-replay.mjs",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "db:migrate:dry": "node scripts/apply-migrations.mjs --dry-run",
    "db:baseline": "node scripts/apply-migrations.mjs --baseline",
    "db:baseline:through": "node scripts/apply-migrations.mjs --baseline-through",
    "schema:doc": "node scripts/schema-doc.mjs > docs/DATABASE_SCHEMA.md",
    "check:picklist": "node scripts/check-picklist.mjs",
    "check:status": "node scripts/check-status.mjs",
    "check:dberror": "esbuild scripts/check-dberror.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-dberror.mjs --log-level=error && node node_modules/.cache/check-dberror.mjs",
    "check:orders": "node scripts/check-order-columns.mjs",
    "check:reports": "node scripts/check-report-columns.mjs",
    "check:paging": "esbuild scripts/check-paging.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-paging.mjs --log-level=error && node node_modules/.cache/check-paging.mjs",
    "inventory": "esbuild scripts/module-inventory.ts --bundle --platform=node --format=esm --define:import.meta.env={} --outfile=node_modules/.cache/inventory.mjs --log-level=error && node node_modules/.cache/inventory.mjs > docs/MODULE_INVENTORY.md",
    "coverage:reqs": "esbuild scripts/requirement-coverage.ts --bundle --platform=node --format=esm --define:import.meta.env={} --outfile=node_modules/.cache/covreqs.mjs --log-level=error && node node_modules/.cache/covreqs.mjs > docs/REQUIREMENT_COVERAGE.md",
    "validate": "node scripts/validate-run.mjs",
    "check:picklist:open": "node scripts/check-picklist-open.mjs",
    "check:nar003": "npm run check:mapping && npm run check:ui",
    "check:scheduled-export": "TZ=Asia/Kolkata node scripts/check-scheduled-export.mjs",
    "check:machine": "esbuild scripts/check-machine-events.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-machine-events.mjs --log-level=error && node node_modules/.cache/check-machine-events.mjs",
    "check:cover-party": "esbuild scripts/check-cover-party.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-cover-party.mjs --log-level=error && node node_modules/.cache/check-cover-party.mjs",
    "check:kyc": "esbuild scripts/check-kyc.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-kyc.mjs --log-level=error && node node_modules/.cache/check-kyc.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.62.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  }
}
